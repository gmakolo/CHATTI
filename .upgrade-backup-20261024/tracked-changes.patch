@@ -4043,6 +4043,29 @@ body.dark-mode.app-authenticated .pending-message-notice.is-limit-reached { colo
 .profile-about > p { margin: 4px 0 0; color: var(--ui-text); line-height: 1.5; }
 .profile-form > label { margin-top: 10px; }
 
+/* Compact, persistent Home post reactions */
+.feed-post-stats { align-items: center; gap: 12px; }
+.feed-reaction-total { color: var(--ui-muted); font-size: .78rem; }
+.feed-reaction-total strong { color: var(--ui-text); }
+.feed-reaction-breakdown { display: flex; flex-wrap: wrap; gap: 5px; min-height: 0; padding-bottom: 7px; }
+.feed-reaction-detail { position: relative; }
+.feed-reaction-detail summary { list-style: none; padding: 3px 8px; border: 1px solid var(--ui-border); border-radius: 999px; background: var(--ui-surface-soft); color: var(--ui-text); font-size: .75rem; cursor: pointer; }
+.feed-reaction-detail summary::-webkit-details-marker { display: none; }
+.feed-reaction-detail > div { position: absolute; z-index: 3; bottom: calc(100% + 6px); left: 0; display: grid; gap: 4px; min-width: 145px; max-height: 150px; overflow: auto; padding: 9px; border: 1px solid var(--ui-border); border-radius: 12px; background: var(--ui-surface); color: var(--ui-text); box-shadow: var(--ui-shadow); font-size: .75rem; }
+.feed-reaction-control { position: relative; }
+body .feed-reaction-trigger { display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 6px 13px; border: 1px solid var(--ui-border) !important; border-radius: 999px; background: var(--ui-surface) !important; color: var(--ui-text) !important; font-size: .84rem; font-weight: 650; cursor: pointer; }
+body .feed-reaction-trigger:hover, body .feed-reaction-trigger.active { border-color: var(--ui-blue) !important; background: var(--ui-blue-soft) !important; color: var(--ui-blue) !important; }
+.feed-reaction-picker[hidden] { display: none !important; }
+.feed-reaction-picker { position: absolute; z-index: 5; bottom: calc(100% + 9px); left: 0; display: grid; grid-template-columns: repeat(4, minmax(64px, 1fr)); gap: 5px; width: min(360px, calc(100vw - 44px)); padding: 9px; border: 1px solid var(--ui-border); border-radius: 15px; background: var(--ui-surface); box-shadow: 0 12px 32px rgba(30,41,59,.18); }
+body .feed-reaction-option { display: grid; justify-items: center; gap: 2px; min-width: 0; min-height: 54px; padding: 5px 3px; border: 1px solid transparent !important; border-radius: 10px; background: var(--ui-surface-soft) !important; color: var(--ui-text) !important; cursor: pointer; }
+body .feed-reaction-option > span { font-size: .61rem; line-height: 1.1; }
+body .feed-reaction-option:hover, body .feed-reaction-option.active { border-color: var(--ui-blue) !important; background: var(--ui-blue) !important; color: #fff !important; }
+body .feed-reaction-option:disabled { opacity: .6; }
+@media (max-width: 520px) {
+  .feed-reaction-picker { grid-template-columns: repeat(3, minmax(58px, 1fr)); }
+  .feed-reaction-trigger { min-height: 40px; }
+}
