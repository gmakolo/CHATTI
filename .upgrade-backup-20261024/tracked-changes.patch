+
+const feedReactionOptions = {{ feed_reaction_options|tojson }};
+function renderPostReactionSummary(post, result) {
+    post.querySelector("[data-reaction-total]").textContent = result.reaction_total;
+    const breakdown = post.querySelector("[data-reaction-breakdown]");
+    breakdown.replaceChildren();
+    feedReactionOptions.forEach(([key, label, emoji]) => {
+        const count = result.reaction_counts[key] || 0;
+        if (!count) return;
+        const details = document.createElement("details"); details.className = "feed-reaction-detail";
+        const summary = document.createElement("summary"); summary.setAttribute("aria-label", `${count} ${label} reactions`);
+        summary.textContent = `${emoji} ${count}`; details.appendChild(summary);
+        const names = document.createElement("div");
+        (result.reaction_people[key] || []).forEach((username) => {
+            const name = document.createElement("span"); name.textContent = username; names.appendChild(name);
+        });
+        details.appendChild(names); breakdown.appendChild(details);
+    });
+}
+
+document.querySelectorAll("[data-reaction-trigger]").forEach((trigger) => {
+    const post = trigger.closest(".feed-post");
+    const picker = post.querySelector("[data-reaction-picker]");
+    trigger.addEventListener("click", () => {
+        const open = picker.hidden;
+        document.querySelectorAll("[data-reaction-picker]").forEach((other) => { other.hidden = true; other.closest(".feed-post").querySelector("[data-reaction-trigger]").setAttribute("aria-expanded", "false"); });
+        picker.hidden = !open; trigger.setAttribute("aria-expanded", String(open));
+    });
+    picker.addEventListener("click", async (event) => {
+        const choice = event.target.closest("[data-reaction]"); if (!choice) return;
+        choice.disabled = true;
+        try {
+            const response = await fetch(`/posts/${post.id.replace("post-", "")}/react`, {
+                method: "POST", headers: {"Content-Type": "application/json"},
+                body: JSON.stringify({reaction: choice.dataset.reaction})
+            });
+            const result = await response.json();
+            if (!response.ok) { window.alert(result.error || "Your reaction could not be saved."); return; }
+            const selected = feedReactionOptions.find(([key]) => key === result.my_reaction);
+            post.querySelector("[data-current-reaction]").textContent = selected ? `${selected[2]} ${selected[1]}` : "☺ React";
+            trigger.classList.toggle("active", Boolean(result.my_reaction));
+            picker.querySelectorAll("[data-reaction]").forEach((button) => button.classList.toggle("active", button.dataset.reaction === result.my_reaction));
+            renderPostReactionSummary(post, result);
+            picker.hidden = true; trigger.setAttribute("aria-expanded", "false");
+        } catch (_) { window.alert("Your reaction could not be saved. Check your connection and try again."); }
+        finally { choice.disabled = false; }
+    });
+});
+document.addEventListener("click", (event) => {
+    if (event.target.closest(".feed-reaction-control")) return;
+    document.querySelectorAll("[data-reaction-picker]:not([hidden])").forEach((picker) => {
+        picker.hidden = true; picker.closest(".feed-post").querySelector("[data-reaction-trigger]").setAttribute("aria-expanded", "false");
+    });
+});
+document.addEventListener("keydown", (event) => {
+    if (event.key !== "Escape") return;
+    document.querySelectorAll("[data-reaction-picker]:not([hidden])").forEach((picker) => {
+        picker.hidden = true; picker.closest(".feed-post").querySelector("[data-reaction-trigger]").setAttribute("aria-expanded", "false");
+    });
+});
 </script>
